{
  "name": "@bible-app/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "parse:bibles": "dotenv -e ../.env.development -- tsx bible-databases/parser.ts",
    "upload:bibles": "dotenv -e ../.env.development -- tsx bible-databases/uploader.ts",
    "generate:lexicons:extended:hebrew": "dotenv -e ../.env.development -- tsx lexicons/extended-strongs/generate-hebrew.ts",
    "generate:lexicons:extended:greek": "dotenv -e ../.env.development -- tsx lexicons/extended-strongs/generate-greek.ts",
    "generate:lexicons:base:hebrew": "dotenv -e ../.env.development -- tsx lexicons/base-strongs/generate-hebrew.ts",
