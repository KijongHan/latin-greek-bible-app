{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022"],
      "module": "esnext",
      "moduleResolution": "bundler",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "isolatedModules": true,
      "noEmit": true,
      "jsx": "preserve",
      "resolveJsonModule": true
    },
    "include": ["src/**/*"]
  }
  